{
  "name": "pulsecheck",
  "version": "0.1.0",
  "private": true,
  "description": "Сервис интерактивных опросов во время лекций (PulseCheck)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup": "docker compose up -d && npm run prisma:migrate -w server && npm run seed -w server",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "migrate": "npm run prisma:migrate -w server",
    "seed": "npm run seed -w server",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm run test -w server",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
