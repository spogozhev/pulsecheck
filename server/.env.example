# Порт API
PORT=3001
# PostgreSQL (в dev поднимается docker compose)
DATABASE_URL=postgresql://slide:slide@localhost:5432/slide_hz?schema=public
# Redis для очередей BullMQ
REDIS_URL=redis://localhost:6379
# Секрет подписи JWT-сессий — заменить в проде
JWT_SECRET=change-me
# Каталог файлового хранилища (оригиналы и PNG слайдов)
STORAGE_DIR=../storage
# Путь до LibreOffice (конвертация PPTX -> PDF). На Linux: /usr/bin/soffice
LIBREOFFICE_PATH=P:\Program Files\LibreOffice\program\soffice.com
# Разрешённые CORS-источники (фронтенд), через запятую
WEB_ORIGIN=http://localhost:5180
# Базовый URL фронтенда — из него строятся QR-ссылки на голосование
PUBLIC_BASE_URL=http://localhost:5180
# SMTP для писем (восстановление пароля). Без SMTP_HOST письма выводятся в консоль сервера (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PulseCheck <no-reply@localhost>
